# Cloudflare Pages headers.
# Copied to the root of the publish directory by scripts/build_dist.py.
#
# JSON is generated on every publish and the dashboard refetches it on load,
# so it must never be served from a stale edge or browser cache. Calendar and
# badge responses may be reused for five minutes; the next request revalidates.
# Content-Type is explicit for .ics and .svg, which Pages does not map
# consistently across all static-asset paths.

/ssl_results.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

/domain_results.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

/status.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

/history.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

/expiries.ics
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: text/calendar; charset=utf-8

/badges/*
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: image/svg+xml; charset=utf-8
